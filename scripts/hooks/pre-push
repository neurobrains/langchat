#!/usr/bin/env python3
"""
Pre-push hook to run ty type checking.
Works on Windows, Linux, and Mac.
"""

import subprocess
import sys

def main():
    """Main hook function."""
    print("=" * 60)
    print("Running ty type checking on Langchat...")
    print("=" * 60)
    
    try:
        result = subprocess.run(
            ["python", "-m", "ty", "check", "src/"],
            check=True,
            capture_output=True,
            text=True
        )
        
        if result.stdout:
            print(result.stdout)
        
        print("\n✅ ty type checking passed!")
        print("=" * 60)
        sys.exit(0)
        
    except subprocess.CalledProcessError as e:
        print("\n❌ ty found type errors. Please fix them before pushing.")
        print("\nError details:")
        print(e.stderr if e.stderr else e.stdout)
        print("\nRun manually: python -m ty check src/")
        print("=" * 60)
        sys.exit(1)
    except Exception as e:
        print(f"\n❌ Unexpected error running ty: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()

